# ─────────────────────────────────────────────────────────────────────────────
# rokdajob API — environment
# Copy this file to backend/.env and fill in the real values.
# Every variable is validated at boot by src/config/env.ts; a bad value stops
# the process immediately instead of failing inside a request.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rokdajob?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/rokdajob
# No Mongo installed? Run `npm run dev:db -w @rokdajob/backend` for an in-memory
# replica set and paste the URI it prints here.
MONGODB_URI=
MONGODB_DB_NAME=rokdajob

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Where the apps live. Email links and the Google redirect are built from these.
APP_WEB_URL=http://localhost:3000
APP_ADMIN_URL=http://localhost:3001

# Set COOKIE_SECURE=true in production (required — the app refuses to boot otherwise).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Google sign-in ───────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials -> Create OAuth client ID
#   Application type: Web application
#   Authorised redirect URI: must match GOOGLE_CALLBACK_URL exactly
# Optional in development (the route answers 503); required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma separated. Add your production domains before deploying.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Cloudinary (profile photos, company logos, documents) ────────────────────
# https://console.cloudinary.com  →  Dashboard  →  API keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rokdajob

# ── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=rokdajob <no-reply@rokdajob.com>

# ── Feature flags ────────────────────────────────────────────────────────────
# Gender / age job filters carry legal exposure — off unless you have reviewed
# the compliance position for your market (see docs/06-RISKS.md R9).
FEATURE_GENDER_AGE_FILTERS=false
# Exposes POST /api/v1/admin/seed. Must stay false in production.
FEATURE_SEED_ROUTE=false
