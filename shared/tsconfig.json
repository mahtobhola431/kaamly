{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here for the Fetch API the http client is built on — `fetch`, `Response`,
    // `RequestInit`, `FormData`, `URLSearchParams`. Declaring it keeps this package
    // self-contained: without it the build only works when a consumer's `@types/node`
    // happens to be hoisted into a parent node_modules, which is not true everywhere.
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
